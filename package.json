{
  "name": "dotty-ai",
  "version": "1.0.0",
  "type": "module",
  "description": "Smart AI-powered typing assistant and desktop editor with real-time caret-following dot indicator",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "cross-env ELECTRON=true vite",
    "build": "tsc && vite build",
    "build:electron": "cross-env ELECTRON=true tsc && vite build",
    "package": "cross-env ELECTRON=true vite build && electron-builder --win",
    "package:portable": "cross-env ELECTRON=true vite build && electron-builder --win portable --x64",
    "preview": "vite preview"
  },
  "keywords": [
    "ai",
    "typing-assistant",
    "grammar-checker",
    "prompt-enhancer",
    "electron",
    "react",
    "languagetool",
    "ollama"
  ],
  "author": "Dotty Open Source",
  "license": "MIT",
  "build": {
    "appId": "com.dotty.app",
    "productName": "Dotty",
    "copyright": "Copyright © 2026 Dotty Contributors",
    "directories": {
      "output": "dist-bin"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dotty AI"
    },
    "portable": {
      "artifactName": "Dotty-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
